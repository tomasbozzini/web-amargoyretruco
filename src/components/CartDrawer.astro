---
/**
 * Panel del carrito (dialog nativo: atrapa el foco y se cierra con Esc).
 * El contenido de la lista lo arma src/scripts/app.ts con textContent.
 */
import { BUSINESS, DELIVERY_FEE_INFO, MIN_DELIVERY_AMOUNT, ORDER_DISCLAIMER, PICKUP_AREA } from '../config';
import { formatPrice } from '../lib/price';
import { CUSTOMER_FIELD_MAX } from '../lib/whatsapp';
import Icon from './Icon.astro';
---

<dialog id="cart" class="cart-panel" aria-labelledby="cart-title" data-cart-dialog>
  <div class="flex h-full flex-col">
    <header class="flex items-center justify-between gap-3 border-b border-verde-oscuro/15 px-4 py-3">
      <div>
        <p class="label text-base text-terracota-oscuro">Tu mano</p>
        <h2 id="cart-title" class="font-display text-3xl leading-none">Tu pedido</h2>
      </div>
      <button type="button" class="inline-flex size-12 items-center justify-center rounded-full hover:bg-crema" data-cart-close>
        <Icon name="close" class="size-6" />
        <span class="sr-only">Cerrar pedido</span>
      </button>
    </header>

    <div class="flex-1 overflow-y-auto px-4 py-4">
      <p class="sr-only" aria-live="polite" data-cart-announce></p>
      <div class="py-8 text-center" data-cart-empty>
        <div class="mx-auto flex w-fit gap-1 text-verde/60" aria-hidden="true">
          <Icon name="espada" class="size-7" />
          <Icon name="basto" class="size-7" />
          <Icon name="oro" class="size-7" />
          <Icon name="copa" class="size-7" />
        </div>
        <p class="mt-3 font-display text-2xl">Todavía no tenés cartas en la mano</p>
        <p class="mt-1 text-verde-oscuro/90">Agregá alguna yerba y armamos el pedido.</p>
        <button type="button" class="btn btn-green mt-5" data-cart-close data-go-catalog>Ver yerbas</button>
      </div>

      <ul class="divide-y divide-verde-oscuro/10" data-cart-lines aria-label="Productos en el pedido"></ul>

      <div data-cart-form hidden>
        <dl class="mt-2 space-y-1 border-t-2 border-dashed border-verde-oscuro/20 pt-3">
          <div class="flex justify-between text-base">
            <dt>Subtotal</dt>
            <dd data-cart-subtotal>$ 0</dd>
          </div>
          <div class="flex items-baseline justify-between">
            <dt class="text-lg font-bold">Total</dt>
            <dd class="font-display text-3xl" data-cart-total>$ 0</dd>
          </div>
        </dl>
        <div class="mt-1 flex items-start justify-between gap-3">
          <p class="text-sm text-mate">
            {DELIVERY_FEE_INFO ?? 'Si elegís delivery, el envío lo coordinamos por WhatsApp.'}
          </p>
          <button type="button" class="min-h-11 shrink-0 rounded-lg px-2 text-sm font-semibold text-terracota-oscuro underline underline-offset-4 hover:bg-crema" data-cart-clear>
            Vaciar pedido
          </button>
        </div>

        <fieldset class="mt-6">
          <legend class="label text-lg">¿Cómo lo recibís?</legend>
          <div class="mt-2 grid gap-2">
            <label class="flex min-h-14 cursor-pointer items-start gap-3 rounded-xl border-2 border-verde-oscuro/20 bg-white p-3 has-[:checked]:border-verde has-[:checked]:bg-verde/5">
              <input type="radio" name="delivery" value="delivery" class="mt-1 size-5 accent-verde" data-delivery-option />
              <span>
                <span class="flex items-center gap-2 font-bold"><Icon name="truck" class="size-5" /> Delivery en {BUSINESS.city}</span>
                <span class="block text-sm text-mate">Compra mínima {formatPrice(MIN_DELIVERY_AMOUNT)}. Solo dentro de {BUSINESS.city}.</span>
              </span>
            </label>
            <label class="flex min-h-14 cursor-pointer items-start gap-3 rounded-xl border-2 border-verde-oscuro/20 bg-white p-3 has-[:checked]:border-verde has-[:checked]:bg-verde/5">
              <input type="radio" name="delivery" value="pickup" class="mt-1 size-5 accent-verde" data-delivery-option />
              <span>
                <span class="flex items-center gap-2 font-bold"><Icon name="pin" class="size-5" /> Retiro en {PICKUP_AREA}</span>
                <span class="block text-sm text-mate">Te pasamos el punto exacto por WhatsApp.</span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="mt-3 rounded-xl border-2 border-terracota bg-terracota/10 p-3" role="status" data-min-warning hidden>
          <p class="font-bold text-terracota-oscuro">
            Te faltan <span data-min-missing></span> para el delivery.
          </p>
          <p class="mt-1 text-sm">
            El mínimo para delivery es {formatPrice(MIN_DELIVERY_AMOUNT)}. Sumá algo más o retiralo en {PICKUP_AREA}.
          </p>
          <button type="button" class="btn btn-outline mt-3 w-full" data-switch-pickup>Cambiar a retiro en {PICKUP_AREA}</button>
        </div>

        <div class="mt-6 grid gap-3">
          <div>
            <label for="cart-name" class="mb-1 block font-bold">Tu nombre <span class="font-normal text-mate">(opcional)</span></label>
            <input id="cart-name" type="text" class="field" autocomplete="given-name" maxlength={CUSTOMER_FIELD_MAX} data-customer-name />
          </div>
          <div>
            <label for="cart-zone" class="mb-1 block font-bold">Zona o barrio <span class="font-normal text-mate">(opcional)</span></label>
            <input id="cart-zone" type="text" class="field" autocomplete="off" maxlength={CUSTOMER_FIELD_MAX} data-customer-zone />
          </div>
        </div>
        <p class="mt-2 text-xs text-mate">Estos datos no se guardan: solo se agregan al mensaje de WhatsApp.</p>
      </div>
    </div>

    <footer class="border-t border-verde-oscuro/15 bg-crema-claro px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]" data-cart-footer hidden>
      <p class="mb-2 text-center text-sm font-semibold text-mate" id="cart-help" data-cart-help></p>
      <a
        class="btn btn-green w-full text-lg"
        target="_blank"
        rel="noopener noreferrer"
        aria-describedby="cart-help cart-disclaimer"
        data-whatsapp-order
      >
        <Icon name="whatsapp" class="size-6" />
        Pedir por WhatsApp
      </a>
      <p class="mt-2 text-center text-xs text-mate" id="cart-disclaimer">{ORDER_DISCLAIMER}.</p>
    </footer>
  </div>
</dialog>

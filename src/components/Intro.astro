---
/**
 * Intro al entrar: un termo ceba un mate y después se desvanece (~2,5 s).
 * - Animación 100% CSS + SVG (sin scripts inline: respeta la CSP).
 * - Se saltea tocando la pantalla o con Esc (lo maneja src/scripts/app.ts).
 * - No se repite al recargar en la misma pestaña (public/intro-gate.js) y no se
 *   muestra si el dispositivo pide "reducir movimiento".
 * - Es decorativa: aria-hidden y sin elementos que reciban foco.
 * Se apaga desde src/config.ts (SHOW_INTRO).
 */
---

<div class="intro on-dark yerba-texture" aria-hidden="true" data-intro>
  <div class="intro-scene flex flex-col items-center px-6 text-center">
    <svg viewBox="8 6 228 219" class="w-[min(80vw,330px)]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="intro-termo-cuerpo" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#4a4a4a" />
          <stop offset="0.35" stop-color="#262626" />
          <stop offset="1" stop-color="#0e0e0e" />
        </linearGradient>
        <radialGradient id="intro-luz">
          <stop offset="0" stop-color="#f3ebd8" stop-opacity="0.16" />
          <stop offset="1" stop-color="#f3ebd8" stop-opacity="0" />
        </radialGradient>
      </defs>
      {/* Luz suave de fondo para que se vea el termo negro */}
      <circle cx="125" cy="128" r="112" fill="url(#intro-luz)" />

      {/* Termo negro con manija y pico cebador rojo (se inclina, ceba y vuelve) */}
      <g class="intro-termo">
        <g transform="translate(12 -1) rotate(70 61 120)">
          {/* manija */}
          <path d="M40 66 H25 Q19 66 19 72 V128" fill="none" stroke="#1a1a1a" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M40 63.5 H25 Q16.5 63.5 16.5 72 V128" fill="none" stroke="#5f6a63" stroke-width="1" stroke-linecap="round" opacity="0.7" />
          {/* cuerpo */}
          <rect x="38" y="72" width="46" height="100" rx="10" fill="url(#intro-termo-cuerpo)" stroke="#4d5a52" stroke-width="1" />
          <rect x="43" y="78" width="4" height="86" rx="2" fill="#ffffff" opacity="0.1" />
          {/* aro */}
          <rect x="36" y="62" width="50" height="13" rx="4" fill="#262626" stroke="#4d5a52" stroke-width="1" />
          {/* tapa con estrías */}
          <rect x="41" y="47" width="40" height="16" rx="3" fill="#151515" stroke="#4d5a52" stroke-width="1" />
          <path d="M45 49.5v11 M49 49.5v11 M53 49.5v11 M57 49.5v11 M61 49.5v11 M65 49.5v11 M69 49.5v11 M73 49.5v11 M77 49.5v11" stroke="#3a3a3a" stroke-width="1.4" />
          {/* tapón y pico cebador */}
          <rect x="46" y="39" width="30" height="9" rx="3" fill="#1c1c1c" stroke="#4d5a52" stroke-width="1" />
          <path d="M55 41 L64 41 L73 27 L66 23 Z" fill="#d7263d" />
          <path d="M66 23 L73 27" stroke="#ff7a86" stroke-width="1.3" stroke-linecap="round" />
        </g>
      </g>

      {/* Chorro de agua: sale del pico, cae al mate y se corta (una sola vez) */}
      <path class="intro-stream" d="M165 95 C170 97 173 106 174 119" fill="none" stroke="#e3f4f7" stroke-width="3.6" stroke-linecap="round" />

      <g transform="translate(63 40)">
        {/* Vapor */}
        <g class="intro-steam" fill="none" stroke="#f3ebd8" stroke-width="2" stroke-linecap="round">
          <path d="M116 70 c-4 -6 4 -10 0 -16 c-3 -4 2 -8 0 -12" />
          <path d="M127 68 c-4 -6 4 -10 0 -16 c-3 -4 2 -8 0 -12" />
          <path d="M138 70 c-4 -6 4 -10 0 -16" />
        </g>

        {/* Mate */}
        <ellipse cx="122" cy="176" rx="34" ry="4" fill="#000000" opacity="0.25" />
        <path d="M84 116 C84 100 92 92 100 88 L144 88 C152 92 160 100 160 116 C160 150 144 172 122 172 C100 172 84 150 84 116 Z" fill="#a0693f" />
        <path d="M140 92 C152 98 156 108 156 118 C156 146 144 166 126 170 C142 160 148 140 146 118 C145 106 142 98 136 92 Z" fill="#7d4f2d" opacity="0.6" />
        <ellipse cx="98" cy="120" rx="4" ry="13" fill="#ffffff" opacity="0.15" />
        <rect x="94" y="78" width="56" height="12" rx="5" fill="#e8dcc0" stroke="#bfae86" stroke-width="1" />
        <ellipse cx="122" cy="80" rx="25" ry="4.5" fill="#5e8f4f" />
        <ellipse class="intro-foam" cx="116" cy="80" rx="12" ry="2.8" fill="#c4dba6" />
        {/* Bombilla */}
        <line x1="132" y1="82" x2="162" y2="26" stroke="#d9cbad" stroke-width="4.5" stroke-linecap="round" />
        <line x1="159" y1="31" x2="164" y2="22" stroke="#bfae86" stroke-width="6" stroke-linecap="round" />
      </g>
    </svg>

    <p class="mt-6 font-display text-4xl leading-none sm:text-5xl">
      Amargo <span class="italic text-[#e9a58f]">y</span> Retruco
    </p>
    <p class="intro-caption label mt-3 text-xl text-[#e9a58f]">
      <span class="intro-caption-1">Cebando el primero…</span>
      <span class="intro-caption-2">¡Servido!</span>
    </p>
  </div>
  <p class="label absolute bottom-[max(1.5rem,env(safe-area-inset-bottom))] text-base text-crema/60">Tocá para saltar</p>
</div>

---
import { ORDER_DISCLAIMER, WHATSAPP_GREETING, WHATSAPP_NUMBER } from '../config';
import type { CatalogResult } from '../lib/catalog';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';

interface Props {
  catalog: CatalogResult;
}

const { catalog } = Astro.props;
const { products, brands, source } = catalog;
const askListUrl = buildWhatsAppUrl(WHATSAPP_NUMBER, '¡Hola Amargo y Retruco! ¿Me pasan la lista de yerbas y precios?');
const consultUrl = buildWhatsAppUrl(WHATSAPP_NUMBER, WHATSAPP_GREETING);
---

<section id="catalogo" class="bg-crema py-16 sm:py-20" aria-labelledby="catalogo-title">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-kicker">Catálogo</p>
    <h2 id="catalogo-title" class="section-title mt-1">Las cartas sobre la mesa</h2>
    <p class="mt-3 max-w-2xl text-lg text-verde-oscuro/90">
      Elegí tus yerbas y armá el pedido. Los precios son por paquete.
    </p>

    {
      source === 'fallback' && products.length > 0 && (
        <p class="mt-4 rounded-xl border-2 border-mate/30 bg-crema-claro px-4 py-3 text-sm text-mate" role="note">
          Estamos mostrando una lista guardada: precios y stock pueden haber cambiado. Te confirmamos todo por WhatsApp.
        </p>
      )
    }

    {
      products.length === 0 ? (
        <div class="naipe mt-10 px-6 py-10 text-center" data-catalog-empty>
          <Icon name="mate" class="mx-auto size-12 text-verde" />
          <h3 class="mt-3 font-display text-3xl">Estamos barajando de nuevo</h3>
          <p class="mx-auto mt-2 max-w-md text-lg">
            Ahora mismo no podemos mostrar la lista de yerbas. Escribinos por WhatsApp y te pasamos lo que hay, con precios.
          </p>
          <a class="btn btn-green mt-6" href={askListUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" class="size-5" />
            Pedir la lista por WhatsApp
          </a>
        </div>
      ) : (
        <div data-catalog>
          {/* Controles: buscador, orden y filtros por marca */}
          <div class="mt-8 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
            <div>
              <label for="catalog-search" class="label mb-1.5 block text-base text-verde-oscuro">
                Buscar yerba
              </label>
              <div class="relative">
                <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-mate" />
                <input
                  id="catalog-search"
                  type="search"
                  class="field pl-12"
                  placeholder="Marca, sabor o presentación"
                  autocomplete="off"
                  maxlength="60"
                  enterkeyhint="search"
                  data-search-input
                />
              </div>
            </div>
            <div>
              <label for="catalog-sort" class="label mb-1.5 block text-base text-verde-oscuro">
                Ordenar
              </label>
              <select id="catalog-sort" class="field pr-10 sm:w-56" data-sort-select>
                <option value="default">Como vienen</option>
                <option value="price-asc">Menor precio</option>
                <option value="price-desc">Mayor precio</option>
              </select>
            </div>
          </div>

          <div class="-mx-4 mt-4 overflow-x-auto px-4 pb-2" role="group" aria-label="Filtrar por marca">
            <div class="flex gap-2 sm:flex-wrap">
              <button type="button" class="chip" aria-pressed="true" data-brand-chip="">
                Todas
              </button>
              {brands.map((brand) => (
                <button type="button" class="chip" aria-pressed="false" data-brand-chip={brand}>
                  {brand}
                </button>
              ))}
            </div>
          </div>

          <p class="mt-3 text-sm text-mate" role="status" aria-live="polite" data-results-count>
            {products.length === 1 ? '1 yerba' : `${products.length} yerbas`}
          </p>

          <ul class="mt-4 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4" data-product-grid>
            {products.map((product, index) => (
              <ProductCard product={product} index={index} />
            ))}
          </ul>

          <div class="naipe mt-6 px-6 py-10 text-center" data-no-results hidden>
            <h3 class="font-display text-3xl">Ni el ancho de espadas te salva</h3>
            <p class="mx-auto mt-2 max-w-md text-lg">
              No encontramos yerbas con esa búsqueda. Probá con otra marca o preguntanos por WhatsApp: capaz la conseguimos.
            </p>
            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
              <button type="button" class="btn btn-outline" data-clear-filters>
                Ver todas las yerbas
              </button>
              <a class="btn btn-green" href={consultUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="whatsapp" class="size-5" />
                Consultar por WhatsApp
              </a>
            </div>
          </div>

          <p class="mt-8 text-center text-sm font-semibold text-mate">
            Precios por paquete. {ORDER_DISCLAIMER}.
          </p>
          <noscript>
            <p class="mt-4 rounded-xl bg-crema-claro p-4 text-center">
              Para armar el pedido en la web necesitás JavaScript activado. También podés{' '}
              <a class="font-bold underline" href={consultUrl} rel="noopener noreferrer">
                escribirnos directo por WhatsApp
              </a>
              .
            </p>
          </noscript>
        </div>
      )
    }
  </div>
</section>

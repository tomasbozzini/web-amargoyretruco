---
/**
 * Ilustración de reemplazo cuando un producto no tiene foto: un naipe con la
 * marca, el palo (espada, basto, oro o copa) y un mate.
 * El palo y los colores se eligen de forma estable a partir del nombre de la marca.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  brand: string;
  presentation?: string;
}

const { brand, presentation = '' } = Astro.props;

const suits: IconName[] = ['espada', 'basto', 'oro', 'copa'];
const themes = [
  { bg: 'bg-verde', text: 'text-crema', accent: 'text-[#e9a58f]' },
  { bg: 'bg-terracota', text: 'text-white', accent: 'text-crema' },
  { bg: 'bg-mate', text: 'text-crema', accent: 'text-[#e9a58f]' },
  { bg: 'bg-verde-oscuro', text: 'text-crema', accent: 'text-[#e9a58f]' },
];

// FNV-1a + mezcla final: reparte bien colores y palos aunque haya pocas marcas.
let hash = 0x811c9dc5;
for (const char of brand) hash = Math.imul(hash ^ char.charCodeAt(0), 0x01000193) >>> 0;
hash ^= hash >>> 16;
hash = Math.imul(hash, 0x85ebca6b);
hash ^= hash >>> 13;
hash = Math.imul(hash, 0xc2b2ae35);
hash = (hash ^ (hash >>> 16)) >>> 0;
const theme = themes[hash % themes.length];
const suit = suits[(hash >>> 8) % suits.length];
const initial = brand.trim().charAt(0).toUpperCase() || '?';
---

<div class:list={['yerba-texture absolute inset-0 flex flex-col items-center justify-center p-4 text-center', theme.bg, theme.text]} aria-hidden="true">
  <span class="naipe-index top-2.5 left-3">
    <span>{initial}</span>
    <Icon name={suit} class:list={['mt-0.5 size-4', theme.accent]} />
  </span>
  <span class="naipe-index right-3 bottom-2.5 rotate-180">
    <span>{initial}</span>
    <Icon name={suit} class:list={['mt-0.5 size-4', theme.accent]} />
  </span>
  <span class="absolute inset-2 rounded-xl border border-current opacity-25"></span>

  <Icon name="mate" class:list={['mb-2 size-10 opacity-90', theme.accent]} />
  <span class="line-clamp-2 font-display text-[1.65rem] leading-[1.05] break-words">{brand}</span>
  {presentation && <span class="label mt-2 text-base opacity-80">{presentation}</span>}
</div>

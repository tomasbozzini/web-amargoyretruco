---
/**
 * Tarjeta de producto. Los datos para el carrito viajan en atributos data-*
 * (Astro los escapa); el script del cliente los lee con `dataset`.
 */
import type { SalesMode } from '../config';
import { stockStatus, type Product } from '../lib/catalog';
import { formatPrice } from '../lib/price';
import { fullProductName, normalizeForSearch } from '../lib/text';
import BrandArt from './BrandArt.astro';
import Icon from './Icon.astro';

interface Props {
  product: Product;
  index: number;
  /** Posición de la marca en el catálogo (define los colores de la ilustración). */
  brandIndex?: number;
  /**
   * 'pausa': sin etiquetas de stock y sin poder agregar ("Muy pronto").
   * 'encargo': como la venta normal (respeta el stock), pero el botón dice "Encargar".
   */
  salesMode?: SalesMode;
}

const { product, index, brandIndex, salesMode = 'normal' } = Astro.props;
const salesPaused = salesMode === 'pausa';
const preorder = salesMode === 'encargo';
const status = stockStatus(product.stock);
const soldOut = status === 'soldout';
/** No se puede agregar: agotado o ventas en pausa. */
const unavailable = soldOut || salesPaused;
/** Etiquetas de stock ("Agotado", "Últimas unidades"): en venta normal y en encargo. */
const showStock = !salesPaused;
const fullName = fullProductName(product.brand, product.name);
const searchText = normalizeForSearch(`${product.brand} ${product.name} ${product.presentation}`);
const titleId = `p-${product.id}-title`;
const itemLabel = [fullName, product.presentation].filter(Boolean).join(' ');
---

<li class="flex" data-product-item>
  <article
    class:list={['naipe flex w-full flex-col overflow-hidden', soldOut && !salesPaused && 'opacity-80']}
    aria-labelledby={titleId}
    data-product
    data-id={product.id}
    data-brand={product.brand}
    data-name={product.name}
    data-presentation={product.presentation}
    data-price={String(product.price)}
    data-stock={String(product.stock)}
    data-search={searchText}
    data-order={String(index)}
  >
    <div class="relative m-2 mb-0 aspect-square overflow-hidden rounded-xl">
      <BrandArt brand={product.brand} presentation={product.presentation} variant={brandIndex} />
      {
        product.photo && (
          <img
            src={product.photo}
            alt={`${fullName}${product.presentation ? ` ${product.presentation}` : ''}`}
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="absolute inset-0 size-full bg-white object-cover"
            data-product-img
          />
        )
      }
      {
        !showStock ? null : soldOut ? (
          <span class="label absolute top-1.5 right-1.5 rounded px-1.5 pt-[3px] pb-[2px] text-[0.7rem] shadow-sm ring-1 sm:top-2 sm:right-2 sm:px-2 sm:py-1 sm:text-sm bg-verde-oscuro text-crema ring-crema">Agotado</span>
        ) : (
          status === 'low' && (
            <span class="label absolute top-1.5 right-1.5 rounded px-1.5 pt-[3px] pb-[2px] text-[0.7rem] shadow-sm ring-1 max-[380px]:max-w-[4rem] max-[380px]:text-center max-[380px]:leading-[1.1] sm:top-2 sm:right-2 sm:px-2 sm:py-1 sm:text-sm bg-crema text-terracota-oscuro ring-terracota-oscuro">Últimas unidades</span>
          )
        )
      }
    </div>

    <div class="flex flex-1 flex-col gap-1 p-3 pt-3 sm:p-4">
      <p class="label text-base text-terracota-oscuro">{product.brand}</p>
      <h3 id={titleId} class="text-base leading-snug font-bold sm:text-lg">{product.name}</h3>
      {product.presentation && <p class="text-sm text-mate">{product.presentation}</p>}
      <p class="mt-auto pt-2 font-display text-2xl text-verde-oscuro">
        <span class="sr-only">Precio: </span><span data-price-value>{formatPrice(product.price)}</span>
      </p>
      <p class="min-h-5 text-sm font-semibold text-terracota-oscuro" data-in-cart></p>
      <button
        type="button"
        class:list={['btn mt-1 w-full', unavailable ? '' : 'btn-green']}
        data-add
        disabled={unavailable}
      >
        {
          salesPaused ? (
            <>
              Muy pronto<span class="sr-only">: {itemLabel}. Renovamos stock pronto.</span>
            </>
          ) : soldOut ? (
            <>
              Agotado<span class="sr-only">: {itemLabel}</span>
            </>
          ) : (
            <>
              <Icon name="plus" class="size-5" />
              <span>{preorder ? 'Encargar' : 'Agregar'}</span>
              <span class="sr-only"> {itemLabel}</span>
            </>
          )
        }
      </button>
      {
        /* Al agregar, el botón se reemplaza por este selector de cantidad (lo maneja src/scripts/app.ts). */
        !unavailable && (
          <div class="mt-1 flex min-h-12 items-stretch rounded-xl border-2 border-verde bg-white" data-card-stepper hidden>
            <button
              type="button"
              class="inline-flex w-12 shrink-0 items-center justify-center rounded-l-[10px] text-verde hover:bg-verde/10"
              aria-label={`Restar uno de ${itemLabel}`}
              data-card-decrease
            >
              <Icon name="minus" class="size-5" />
            </button>
            <span class="flex flex-1 items-center justify-center text-lg font-bold text-verde-oscuro">
              <span class="sr-only">En tu pedido: </span>
              <span data-card-qty>0</span>
            </span>
            <button
              type="button"
              class="inline-flex w-12 shrink-0 items-center justify-center rounded-r-[10px] text-verde hover:bg-verde/10 disabled:cursor-not-allowed disabled:text-[#9a9a92] disabled:hover:bg-transparent"
              aria-label={`Sumar uno de ${itemLabel}`}
              data-card-increase
            >
              <Icon name="plus" class="size-5" />
            </button>
          </div>
        )
      }
    </div>
  </article>
</li>

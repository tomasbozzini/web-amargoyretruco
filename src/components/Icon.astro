---
/**
 * Íconos SVG inline (sin dependencias). Decorativos por defecto (aria-hidden).
 * Palos de la baraja española: espada, basto, oro, copa.
 */
export type IconName =
  | 'whatsapp'
  | 'instagram'
  | 'cart'
  | 'close'
  | 'plus'
  | 'minus'
  | 'trash'
  | 'search'
  | 'mate'
  | 'truck'
  | 'pin'
  | 'cash'
  | 'chevron'
  | 'espada'
  | 'basto'
  | 'oro'
  | 'copa';

interface Props {
  name: IconName;
  class?: string;
  title?: string;
}

const { name, class: className = 'size-5', title } = Astro.props;
const stroke = ['cart', 'close', 'plus', 'minus', 'trash', 'search', 'truck', 'pin', 'cash', 'chevron', 'instagram'].includes(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={stroke ? 'none' : 'currentColor'}
  stroke={stroke ? 'currentColor' : 'none'}
  stroke-width={stroke ? 2 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  {
    name === 'whatsapp' && (
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.59-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.34m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z" />
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    name === 'cart' && (
      <>
        <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L20.5 8H6.2" />
        <circle cx="10" cy="20" r="1.3" />
        <circle cx="17" cy="20" r="1.3" />
      </>
    )
  }
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'minus' && <path d="M5 12h14" />}
  {name === 'trash' && <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3" />}
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="M20 20l-3.5-3.5" />
      </>
    )
  }
  {
    name === 'mate' && (
      <>
        <path d="M5.2 12.4C5.2 9.9 6.4 8.3 7.4 7.6h9.2c1 .7 2.2 2.3 2.2 4.8 0 4.6-3 8.1-6.8 8.1s-6.8-3.5-6.8-8.1Z" />
        <rect x="6.6" y="5.6" width="10.8" height="2.6" rx="1.1" />
        <path d="m13.2 6.2 4.3-5.4 1.3 1-4.2 5.4Z" />
        <path d="M18.1.7h2.6v1.5h-2.6Z" />
      </>
    )
  }
  {
    name === 'truck' && (
      <>
        <path d="M2 6h11v10H2zM13 10h4l3 3v3h-7" />
        <circle cx="6" cy="18" r="1.8" />
        <circle cx="17" cy="18" r="1.8" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
  {
    name === 'cash' && (
      <>
        <rect x="2.5" y="6" width="19" height="12" rx="2" />
        <circle cx="12" cy="12" r="2.5" />
        <path d="M6 9.5v5M18 9.5v5" />
      </>
    )
  }
  {name === 'chevron' && <path d="M6 9l6 6 6-6" />}
  {
    name === 'espada' && (
      <>
        <path d="M12 1.5 14 5v9.5h-4V5Z" />
        <path d="M6.5 14.5h11v2h-11Z" />
        <path d="M11 16.5h2v4.2h-2Z" />
        <circle cx="12" cy="21.6" r="1.4" />
      </>
    )
  }
  {
    name === 'basto' && (
      <>
        <path d="M9.4 2.6c1.6-1 4.2-.5 5 1.3.5 1.2.1 2.4-.2 3.3l-1.9 13.6c-.1.6-.6 1-1.2.9-.6 0-1-.5-1-1.1L8.6 6.4c-.2-1.4-.2-3 .8-3.8Z" />
        <circle cx="8.3" cy="9" r="1.1" />
        <circle cx="15.2" cy="11.5" r="1" />
        <circle cx="8.9" cy="14.8" r="0.9" />
      </>
    )
  }
  {
    name === 'oro' && (
      <>
        <path
          fill-rule="evenodd"
          d="M12 2.5a9.5 9.5 0 1 1 0 19 9.5 9.5 0 0 1 0-19Zm0 3.5a6 6 0 1 0 0 12 6 6 0 0 0 0-12Z"
        />
        <circle cx="12" cy="12" r="3" />
      </>
    )
  }
  {
    name === 'copa' && (
      <>
        <path d="M5.5 2.5h13c0 5.4-2.6 9-6.5 9s-6.5-3.6-6.5-9Z" />
        <path d="M11 11h2v6h-2Z" />
        <path d="M7 18.5c0-1 1-1.5 2-1.5h6c1 0 2 .5 2 1.5V21H7Z" />
      </>
    )
  }
</svg>
